From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Wed, 11 Nov 2026 17:50:57 -0800
Subject: [PATCH] [local #0001] Initialize a pointer of any type with the label
 of a string literal

printIvalPtr() sent only character pointers and pointers to unsigned
integers to printIvalCharPtr(). For a string literal, constExprValue()
returns a value that is flagged as a literal, has the name of the
string, and has the compiler's own pointer to the characters as its
number. printIvalPtr() printed that number for the other pointer types.
A pointer to void, int, or long that is initialized by data with a
string literal got bytes of a host address, and these bytes differ from
one run of the compiler to the next. When only const objects of these
pointer types referred to a literal, the string was not emitted. The
fault occurred on mcs51, stm8, and z80. On mcs51 it occurred for const
objects in every model and for initialized objects in xdata.

printIvalPtr() now sends the value of a string literal to
printIvalCharPtr() for every object pointer type. printIvalCharPtr()
prints the label and enters the string in ccpStr, and emitStaticSeg()
then emits the string. The type check in printIvalPtr() is skipped for
this value, as it is for character pointers. On mcs51 the check gave
warning 18 (Initializer different levels of indirections) for a pointer
to void in code memory that is initialized with a string literal.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCglue.c                             |   6 +-
 support/regression/tests/strlit-ptr-init.c | 116 +++++++++++++++++++++
 support/valdiag/tests/strlit-ptr-init.c    |  16 +++
 3 files changed, 136 insertions(+), 2 deletions(-)
 create mode 100644 support/regression/tests/strlit-ptr-init.c
 create mode 100644 support/valdiag/tests/strlit-ptr-init.c

diff --git a/src/SDCCglue.c b/src/SDCCglue.c
index 40749e638..27e9e0c56 100644
--- a/src/SDCCglue.c
+++ b/src/SDCCglue.c
@@ -1849,8 +1849,10 @@ printIvalPtr (symbol *sym, sym_link *type, initList *ilist, struct dbuf_s *oBuf)
   if (!(val = initPointer (ilist, type, 1)))
     return;
 
-  /* if character pointer */
-  if (IS_CHAR (type->next) || IS_INT (type->next) && IS_UNSIGNED (type->next))
+  /* if character pointer, or if the value is a string literal, which is
+     flagged as a literal and has the name of the string for its address */
+  if (IS_CHAR (type->next) || IS_INT (type->next) && IS_UNSIGNED (type->next) ||
+      IS_LITERAL (val->etype) && val->sym && val->sym->isstrlit)
     if (printIvalCharPtr (sym, type, val, oBuf))
       return;
 
diff --git a/support/regression/tests/strlit-ptr-init.c b/support/regression/tests/strlit-ptr-init.c
new file mode 100644
index 000000000..993c14462
--- /dev/null
+++ b/support/regression/tests/strlit-ptr-init.c
@@ -0,0 +1,116 @@
+/** strlit-ptr-init.c
+    A pointer that is not a character pointer and is initialized by data
+    with a string literal got bytes of the compiler's own address of the
+    literal instead of the label of the literal.
+ */
+
+#include <testfwk.h>
+
+#include <stddef.h>
+
+#ifdef __SDCC
+/* SDCC accepts a wide string literal for a pointer to int or long with this warning */
+#pragma disable_warning 244
+#endif
+
+struct s
+{
+  int i;
+  const void *p;
+};
+
+const void *voidPtr = "AB";
+const void *wideVoidPtr = L"CD";
+const void * const constVoidPtr = "EF";
+const void * const constWideVoidPtr = L"GH";
+
+struct s var = { 1, "IJ" };
+const struct s cst = { 2, L"KL" };
+const void * const arr[2] = { "MN", L"OP" };
+
+/* one literal for a pointer to void and a character pointer */
+const void * const sharedVoidPtr = "QR";
+const char * const sharedCharPtr = "QR";
+
+#ifdef __SDCC
+const int *intPtr = L"ST";
+const long * const constLongPtr = L"UV";
+#endif
+
+#ifdef __SDCC_mcs51
+const void __code *codePtr = "WX";
+const void __code * const constCodePtr = "YZ";
+#endif
+
+#define NARROW(p) ((const char *) (p))
+#define WIDE(p) ((const wchar_t *) (p))
+
+void
+testVoidPtr (void)
+{
+  ASSERT (NARROW (voidPtr)[0] == 'A');
+  ASSERT (NARROW (voidPtr)[1] == 'B');
+  ASSERT (NARROW (voidPtr)[2] == 0);
+
+  ASSERT (WIDE (wideVoidPtr)[0] == L'C');
+  ASSERT (WIDE (wideVoidPtr)[1] == L'D');
+  ASSERT (WIDE (wideVoidPtr)[2] == 0);
+}
+
+void
+testConstVoidPtr (void)
+{
+  ASSERT (NARROW (constVoidPtr)[0] == 'E');
+  ASSERT (NARROW (constVoidPtr)[1] == 'F');
+  ASSERT (NARROW (constVoidPtr)[2] == 0);
+
+  ASSERT (WIDE (constWideVoidPtr)[0] == L'G');
+  ASSERT (WIDE (constWideVoidPtr)[1] == L'H');
+  ASSERT (WIDE (constWideVoidPtr)[2] == 0);
+
+  ASSERT (NARROW (sharedVoidPtr)[0] == 'Q');
+  ASSERT (NARROW (sharedVoidPtr)[1] == 'R');
+  ASSERT (sharedCharPtr[0] == 'Q');
+  ASSERT (sharedCharPtr[1] == 'R');
+}
+
+void
+testAggregate (void)
+{
+  ASSERT (var.i == 1);
+  ASSERT (NARROW (var.p)[0] == 'I');
+  ASSERT (NARROW (var.p)[1] == 'J');
+
+  ASSERT (cst.i == 2);
+  ASSERT (WIDE (cst.p)[0] == L'K');
+  ASSERT (WIDE (cst.p)[1] == L'L');
+
+  ASSERT (NARROW (arr[0])[0] == 'M');
+  ASSERT (NARROW (arr[0])[1] == 'N');
+  ASSERT (WIDE (arr[1])[0] == L'O');
+  ASSERT (WIDE (arr[1])[1] == L'P');
+}
+
+void
+testIntPtr (void)
+{
+#ifdef __SDCC
+  ASSERT (WIDE (intPtr)[0] == L'S');
+  ASSERT (WIDE (intPtr)[1] == L'T');
+
+  ASSERT (WIDE (constLongPtr)[0] == L'U');
+  ASSERT (WIDE (constLongPtr)[1] == L'V');
+#endif
+}
+
+void
+testCodePtr (void)
+{
+#ifdef __SDCC_mcs51
+  ASSERT (((const char __code *) codePtr)[0] == 'W');
+  ASSERT (((const char __code *) codePtr)[1] == 'X');
+
+  ASSERT (((const char __code *) constCodePtr)[0] == 'Y');
+  ASSERT (((const char __code *) constCodePtr)[1] == 'Z');
+#endif
+}
diff --git a/support/valdiag/tests/strlit-ptr-init.c b/support/valdiag/tests/strlit-ptr-init.c
new file mode 100644
index 000000000..4ef902dc0
--- /dev/null
+++ b/support/valdiag/tests/strlit-ptr-init.c
@@ -0,0 +1,16 @@
+/* strlit-ptr-init.c
+
+   A pointer to void that is initialized with a string literal has the
+   right level of indirection. For such a pointer into code memory the
+   mcs51 port gave warning 18 (Initializer different levels of
+   indirections).
+ */
+
+#ifdef TEST1
+const void *p = "AB";
+const void * const cp = "CD";
+#ifdef __SDCC_mcs51
+const void __code *q = "EF";
+const void __code * const cq = "GH";
+#endif
+#endif
