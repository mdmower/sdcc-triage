From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Wed, 11 Nov 2026 21:57:56 -0800
Subject: [PATCH] [local #0004] Clear the register parameter flags when
 reg_parm returns 0

addDecl() calls processFunc() each time it adds a part to a type that
contains a function declarator. When function attributes such as
__reentrant, __critical, or __using follow the parameter list, the
first call that has the parameters is made before the return type is
added. processFunc() passes each parameter to the port's reg_parm()
and sets SPEC_REGPARM and SPEC_ARGREG when the result is not 0. It did
not clear them when the result of a later call was 0.

reg_parm() of mcs51 returns 0 for every parameter of a function that
returns a struct or union. With a function attribute, the parameters
that go into registers for other return types were marked before the
return type was in the type and stayed marked. The front end then
generated RECEIVE and SEND for parameters that the code generator
does not pass in registers. For

    struct s f (unsigned char x) __reentrant { ... }

sdcc -mmcs51 stopped with SIGSEGV in genReceive(). When genFunction()
generated the RECEIVE itself, as it does for a 4-byte parameter that
is held in registers, the function read registers that callers do not
load. Direct calls did not pass the argument, and the compiler stopped
at an assertion in genPcall() for calls through a pointer to this
function type.

processFunc() now clears both flags when reg_parm() returns 0, in the
type of the parameter and in the type of its symbol.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCsymt.c                                |  20 ++-
 .../regression/tests/struct-return-funcattr.c | 160 ++++++++++++++++++
 2 files changed, 178 insertions(+), 2 deletions(-)
 create mode 100644 support/regression/tests/struct-return-funcattr.c

diff --git a/src/SDCCsymt.c b/src/SDCCsymt.c
index cb46a6639..793dfa57a 100644
--- a/src/SDCCsymt.c
+++ b/src/SDCCsymt.c
@@ -4465,9 +4465,25 @@ processFunc (symbol *func, sym_link *funcType)
               SPEC_ARGREG (val->sym->etype) = argreg;
             }
         }
-      else if (IFFUNC_ISREENT (funcType))
+      else
         {
-          FUNC_HASSTACKPARM (funcType) = 1;
+          /* remove the mark of an earlier call. This function is */
+          /* also called before the return type is in the type, */
+          /* for example when function attributes are added, and */
+          /* the port's reg_parm can test the return type */
+          if (IS_REGPARM (val->etype))
+            {
+              SPEC_REGPARM (val->etype) = 0;
+              SPEC_ARGREG (val->etype) = 0;
+            }
+          if (val->sym && IS_REGPARM (val->sym->etype))
+            {
+              SPEC_REGPARM (val->sym->etype) = 0;
+              SPEC_ARGREG (val->sym->etype) = 0;
+            }
+
+          if (IFFUNC_ISREENT (funcType))
+            FUNC_HASSTACKPARM (funcType) = 1;
         }
 
       /* if this is an internal generated function call */
diff --git a/support/regression/tests/struct-return-funcattr.c b/support/regression/tests/struct-return-funcattr.c
new file mode 100644
index 000000000..c23456741
--- /dev/null
+++ b/support/regression/tests/struct-return-funcattr.c
@@ -0,0 +1,160 @@
+/* struct-return-funcattr.c
+   Functions that return a struct, have a non-struct first parameter, and
+   have a function attribute after the parameter list, such as __reentrant
+   or __using. For mcs51 these parameters are passed on the stack, and the
+   front end must not keep the register parameter mark that it sets before
+   the return type is known.
+   __critical is not tested here, because __critical functions that return
+   a struct return a wrong value for mcs51 and z80 for another reason.
+ */
+
+#include <testfwk.h>
+
+#ifdef __SDCC_mcs51
+#define USING0 __using (0)
+#else
+#define USING0
+#endif
+
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+struct s
+{
+  unsigned char a;
+  int b;
+  unsigned char c;
+};
+
+union u
+{
+  unsigned char a;
+  long b;
+};
+
+/* Declared here and defined after the calls, so that the calls are compiled
+   from the declarations. */
+struct s late (unsigned char x) __reentrant;
+struct s lateBank (unsigned char) USING0;
+struct s (*fp) (unsigned char x) __reentrant;
+
+struct s
+reent (unsigned char x) __reentrant
+{
+  struct s r;
+  r.a = x;
+  r.b = 0x1200 + x;
+  r.c = x ^ 0xff;
+  return r;
+}
+
+struct s
+bank (unsigned char x) USING0
+{
+  struct s r;
+  r.a = x;
+  r.b = 0x3400 + x;
+  r.c = x ^ 0xff;
+  return r;
+}
+
+struct s
+two (unsigned char x, int y) __reentrant
+{
+  struct s r;
+  r.a = x;
+  r.b = y;
+  r.c = x ^ 0xff;
+  return r;
+}
+
+union u
+un (long x) __reentrant
+{
+  union u r;
+  r.b = x + 1;
+  return r;
+}
+
+/* The return type is a pointer, which does not change how the parameter
+   is passed. */
+struct s *
+ptr (struct s *p) __reentrant
+{
+  p->a++;
+  return p;
+}
+#endif
+
+void
+testDefinition (void)
+{
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+  struct s r;
+  union u v;
+
+  r = reent (0x11);
+  ASSERT (r.a == 0x11);
+  ASSERT (r.b == 0x1211);
+  ASSERT (r.c == 0xee);
+
+  r = bank (0x31);
+  ASSERT (r.a == 0x31);
+  ASSERT (r.b == 0x3431);
+  ASSERT (r.c == 0xce);
+
+  r = two (0x41, 0x4567);
+  ASSERT (r.a == 0x41);
+  ASSERT (r.b == 0x4567);
+  ASSERT (r.c == 0xbe);
+
+  v = un (0x12345677);
+  ASSERT (v.b == 0x12345678);
+
+  ASSERT (ptr (&r)->a == 0x42);
+#endif
+}
+
+void
+testDeclaration (void)
+{
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+  struct s r;
+
+  r = late (0x51);
+  ASSERT (r.a == 0x51);
+  ASSERT (r.b == 0x5651);
+  ASSERT (r.c == 0xae);
+
+  r = lateBank (0x71);
+  ASSERT (r.a == 0x71);
+  ASSERT (r.b == 0x7871);
+  ASSERT (r.c == 0x8e);
+
+  fp = reent;
+  r = fp (0x61);
+  ASSERT (r.a == 0x61);
+  ASSERT (r.b == 0x1261);
+  ASSERT (r.c == 0x9e);
+#endif
+}
+
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+struct s
+late (unsigned char x) __reentrant
+{
+  struct s r;
+  r.a = x;
+  r.b = 0x5600 + x;
+  r.c = x ^ 0xff;
+  return r;
+}
+
+struct s
+lateBank (unsigned char x) USING0
+{
+  struct s r;
+  r.a = x;
+  r.b = 0x7800 + x;
+  r.c = x ^ 0xff;
+  return r;
+}
+#endif
