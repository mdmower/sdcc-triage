From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Tue, 17 Nov 2026 20:25:20 -0800
Subject: [PATCH] [bugs #4253] mcs51: keep the result of a call in A and B
 while registers are restored from the external stack

With --xstack, genCall() assigns the result of a call and then restores
the registers that were in use at the call from the external stack.
unsaveRegisters() reads each register through A. With --opt-code-size
and two or more registers it calls sdcc_xpop_regs, which takes a count
and a register mask in A and B. When the result of the call is in A, or
in A and B, for the operation after the call, genCall() has to push
those registers first.

genCall() pushed A when aop->regs[A_IDX] of the result was greater than
0. regs[] has the index of the byte that is in each register, and -1 for
a register without a byte of the operand, so the value is 0 for a char
result in A, and A was not pushed. r14433 introduced that test. Since
then, `if (f (i))` tested the value of the register that was restored
last in place of the result of f() when a register was in use at the
call. genCall() did not push B. With --opt-code-size, the register mask
replaced the high byte of an int result. Bugs #4254 reports both faults
for an int result.

genCall() now pushes A when regs[A_IDX] is 0 or more. It also pushes B
when the result has a byte in B and --opt-code-size is in effect.

Adds tests/bug-4253.c and tests/bug-4254.c. The faults occur only with
--xstack, which only the mcs51-xstack-auto variant of the regression
suite passes.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/gen.c                     | 13 ++++-
 support/regression/tests/bug-4253.c | 81 +++++++++++++++++++++++++++++
 support/regression/tests/bug-4254.c | 66 +++++++++++++++++++++++
 3 files changed, 159 insertions(+), 1 deletion(-)
 create mode 100644 support/regression/tests/bug-4253.c
 create mode 100644 support/regression/tests/bug-4254.c

diff --git a/src/mcs51/gen.c b/src/mcs51/gen.c
index 54110ccf8..ac68c39f9 100644
--- a/src/mcs51/gen.c
+++ b/src/mcs51/gen.c
@@ -4095,6 +4095,8 @@ genCall (iCode * ic)
   bool swapBanks = FALSE;
   bool accuse = FALSE;
   bool accPushed = FALSE;
+  bool buse = false;
+  bool bPushed = false;
   bool resultInF0 = FALSE;
   bool assignResultGenerated = FALSE;
 
@@ -4225,7 +4227,8 @@ genCall (iCode * ic)
       _G.accInUse--;
 
       assignResultValue (IC_RESULT (ic), IC_LEFT (ic));
-      accuse = (IC_RESULT (ic)->aop->regs[A_IDX] > 0);
+      accuse = (IC_RESULT (ic)->aop->regs[A_IDX] >= 0);
+      buse = (IC_RESULT (ic)->aop->regs[B_IDX] >= 0);
       assignResultGenerated = true;
 
       freeAsmop (IC_RESULT (ic), NULL, ic, true);
@@ -4284,6 +4287,12 @@ genCall (iCode * ic)
           emitpush ("acc");
           accPushed = TRUE;
         }
+      if (buse && options.useXstack && optimize.codeSize)
+        {
+          /* sdcc_xpop_regs takes a part of its register mask in b */
+          emitpush ("b");
+          bPushed = true;
+        }
       unsaveRegisters (ic);
     }
 
@@ -4297,6 +4306,8 @@ genCall (iCode * ic)
       freeAsmop (IC_RESULT (ic), NULL, ic, TRUE);
     }
 
+  if (bPushed)
+    emitpop ("b");
   if (accPushed)
     emitpop ("acc");
 }
diff --git a/support/regression/tests/bug-4253.c b/support/regression/tests/bug-4253.c
new file mode 100644
index 000000000..efb6137f6
--- /dev/null
+++ b/support/regression/tests/bug-4253.c
@@ -0,0 +1,81 @@
+/* bug-4253.c
+   A function tests the char result of a call while registers are in use
+   at the call. With --xstack, the mcs51 port restores the registers from
+   the external stack through A after the call, and the result of the call
+   is in A for the conditional jump.
+ */
+
+#include <testfwk.h>
+
+static unsigned char digits[4] = {0, 0, 5, 7};
+
+static unsigned char
+digitAt (unsigned char k)
+{
+  return digits[k];
+}
+
+/* One register is in use at the call. */
+static unsigned char
+first (void)
+{
+  unsigned char i;
+
+  for (i = 0; i < 3; i++)
+    {
+      unsigned char d = digitAt (i);
+      if (d)
+        break;
+    }
+  return i;
+}
+
+/* The call is in the condition of the loop. */
+static unsigned char
+firstWhile (void)
+{
+  unsigned char i = 0;
+
+  while (i < 3 && !digitAt (i))
+    i++;
+  return i;
+}
+
+/* Several registers are in use at the call. */
+static unsigned int
+sumOfIndexes (unsigned char from, unsigned char to)
+{
+  unsigned char i;
+  unsigned int sum = 0x100;
+
+  for (i = from; i < to; i++)
+    if (digitAt (i))
+      sum += i;
+  return sum;
+}
+
+#pragma opt_code_size
+
+/* With --opt-code-size, a library function restores several registers. */
+static unsigned int
+sumOfIndexesSize (unsigned char from, unsigned char to)
+{
+  unsigned char i;
+  unsigned int sum = 0x100;
+
+  for (i = from; i < to; i++)
+    if (digitAt (i))
+      sum += i;
+  return sum;
+}
+
+void
+testBug (void)
+{
+  ASSERT (first () == 2);
+  ASSERT (firstWhile () == 2);
+  ASSERT (sumOfIndexes (0, 4) == 0x105);
+  ASSERT (sumOfIndexes (1, 3) == 0x102);
+  ASSERT (sumOfIndexesSize (0, 4) == 0x105);
+  ASSERT (sumOfIndexesSize (1, 3) == 0x102);
+}
diff --git a/support/regression/tests/bug-4254.c b/support/regression/tests/bug-4254.c
new file mode 100644
index 000000000..472d4124b
--- /dev/null
+++ b/support/regression/tests/bug-4254.c
@@ -0,0 +1,66 @@
+/* bug-4254.c
+   A function tests the int result of a call for zero while registers are
+   in use at the call. The mcs51 port has the result in A and B for the
+   test. With --xstack, it restores the registers from the external stack
+   after the call, through A or with a library function that takes its
+   arguments in A and B.
+ */
+
+#include <testfwk.h>
+
+static unsigned int table[3] = {0x0100, 0, 0x0001};
+static unsigned int usedA, usedB;
+
+static unsigned int
+get (unsigned char k)
+{
+  return table[k];
+}
+
+static void
+use (unsigned int a, unsigned int b)
+{
+  usedA = a;
+  usedB = b;
+}
+
+/* a is in registers at the call of get(). */
+static unsigned char
+test (unsigned int a, unsigned int b, unsigned char k)
+{
+  if (!get (k))
+    return 0;
+  use (a, b);
+  return 1;
+}
+
+#pragma opt_code_size
+
+/* With --opt-code-size, a library function restores the registers. */
+static unsigned char
+testSize (unsigned int a, unsigned int b, unsigned char k)
+{
+  if (!get (k))
+    return 0;
+  use (a, b);
+  return 1;
+}
+
+void
+testBug (void)
+{
+  ASSERT (test (0x1234, 0x5678, 1) == 0);
+  ASSERT (usedA == 0);
+  ASSERT (test (0, 0x5678, 2) == 1);
+  ASSERT (usedA == 0 && usedB == 0x5678);
+  ASSERT (test (0x1234, 0, 0) == 1);
+  ASSERT (usedA == 0x1234 && usedB == 0);
+
+  usedA = 0;
+  ASSERT (testSize (0x1234, 0x5678, 1) == 0);
+  ASSERT (usedA == 0);
+  ASSERT (testSize (0, 0x5678, 2) == 1);
+  ASSERT (usedA == 0 && usedB == 0x5678);
+  ASSERT (testSize (0x1234, 0, 0) == 1);
+  ASSERT (usedA == 0x1234 && usedB == 0);
+}
