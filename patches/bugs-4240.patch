From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Mon, 9 Nov 2026 23:13:54 -0800
Subject: [PATCH] [bugs #4240] Do not reverse a loop whose body uses the loop
 variable through a cast

isConformingBody() decides whether a for loop may be turned into a
counting-down loop. It looked for the loop control variable only as a
direct operand of the operators it lists, so '(uint8_t)i' in the body
was not found and the iterations ran in reverse order with the wrong
values of i.

Treat the variable as used when it is a direct operand of any other
operator as well.

Adds tests/bug-4240.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCast.c                       |  6 +++
 support/regression/tests/bug-4240.c | 80 +++++++++++++++++++++++++++++
 2 files changed, 86 insertions(+)
 create mode 100644 support/regression/tests/bug-4240.c

diff --git a/src/SDCCast.c b/src/SDCCast.c
index 4f74c3571..07bae2afd 100644
--- a/src/SDCCast.c
+++ b/src/SDCCast.c
@@ -2657,6 +2657,12 @@ isConformingBody (ast * pbody, symbol * sym, ast * body)
       break;
 
     default:
+      /* Any other operator that has the loop control variable as a direct operand uses its
+         value: a cast, for instance. The cases above only know the operators they list. */
+      if (IS_AST_SYM_VALUE (pbody->left) && isSymbolEqual (AST_SYMBOL (pbody->left), sym))
+        return false;
+      if (IS_AST_SYM_VALUE (pbody->right) && isSymbolEqual (AST_SYMBOL (pbody->right), sym))
+        return false;
       break;
     }
 
diff --git a/support/regression/tests/bug-4240.c b/support/regression/tests/bug-4240.c
new file mode 100644
index 000000000..94d2fb023
--- /dev/null
+++ b/support/regression/tests/bug-4240.c
@@ -0,0 +1,80 @@
+/* bug-4240.c
+   Loop reversal turned a counting-up loop into a counting-down one although
+   the body used the loop variable: isConformingBody() only looked for the
+   variable as a direct operand of the operators it lists, so a use through
+   a cast or as the condition of an if statement went unnoticed.
+ */
+
+#include <testfwk.h>
+
+#include <stdint.h>
+
+static uint8_t seq, k, n, m;
+
+static uint8_t
+get (void)
+{
+  return seq++;
+}
+
+static uint8_t
+withCall (void)
+{
+  static uint8_t i;
+  uint8_t bad = 0;
+
+  for (i = 0; i < 15; i++)
+    if (get () != (uint8_t)i)
+      bad++;
+  return bad;
+}
+
+static void
+withCast (void)
+{
+  static uint8_t i;
+
+  for (i = 0; i < 15; i++)
+    if ((uint8_t)i == k)
+      k++;
+}
+
+static void
+asCondition (void)
+{
+  uint8_t i;
+
+  for (i = 0; i < 10; i++)
+    if (i)
+      n++;
+}
+
+static void
+castToWider (void)
+{
+  uint8_t i;
+
+  for (i = 0; i < 10; i++)
+    if ((unsigned int)i == m)
+      m += 2;
+}
+
+void
+testBug (void)
+{
+  seq = 0;
+  k = 0;
+  n = 0;
+  m = 0;
+
+  ASSERT (withCall () == 0);
+
+  withCast ();
+  ASSERT (k == 15);
+
+  asCondition ();
+  ASSERT (n == 9);
+
+  castToWider ();
+  ASSERT (m == 10);
+}
