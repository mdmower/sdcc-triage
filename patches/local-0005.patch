From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Thu, 12 Nov 2026 02:33:50 -0800
Subject: [PATCH] [local #0005] mcs51: remove the struct return pointer from
 the external stack after a call through a pointer

Callers of functions that return a struct or union pass the address of
the result object as a hidden pointer. Since r14382, pushbigreturn()
writes that pointer to the external stack when --xstack is in effect
and the result object is on that stack, and genCall() removes it from
the external stack after the call. genPcall() was not changed and
removed the pointer from the internal stack with emitpop(). The
compiler stopped with the internal error "stack underflow" at each call
through a pointer to such a function when the calling function was
compiled with --stack-auto --xstack, or with --xstack and __reentrant.

genPcall() now emits three decrements of the external stack pointer
when pushbigreturn() wrote the hidden pointer to the external stack.
When the result object is not on the stack, pushbigreturn() pushes the
pointer on the internal stack with --xstack too, and genPcall() removes
it from the internal stack.

Adds tests/funptr-struct-return-xstack.c. The fault occurs only with
--xstack, which only the mcs51-xstack-auto variant of the regression
suite passes. With that variant the test compiles and does not link,
because genRet() names the external stack pointer spx since r17144 and
the library defines _spx.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/gen.c                               |  16 ++-
 .../tests/funptr-struct-return-xstack.c       | 131 ++++++++++++++++++
 2 files changed, 144 insertions(+), 3 deletions(-)
 create mode 100644 support/regression/tests/funptr-struct-return-xstack.c

diff --git a/src/mcs51/gen.c b/src/mcs51/gen.c
index c80d6c5de..26e69c238 100644
--- a/src/mcs51/gen.c
+++ b/src/mcs51/gen.c
@@ -4504,9 +4504,19 @@ genPcall (iCode * ic)
   // Adjust stack pointer for the hidden pointer parameter.
   if (bigreturn)
     {
-      emitpop (0);
-      emitpop (0);
-      emitpop (0);
+      // pushbigreturn () puts it on the external stack only when the result object is on that stack.
+      if (options.useXstack && OP_SYMBOL (IC_RESULT (ic))->onStack)
+        {
+          emitcode ("dec", "%s", spname);
+          emitcode ("dec", "%s", spname);
+          emitcode ("dec", "%s", spname);
+        }
+      else
+        {
+          emitpop (0);
+          emitpop (0);
+          emitpop (0);
+        }
     }
 
   if (swapBanks)
diff --git a/support/regression/tests/funptr-struct-return-xstack.c b/support/regression/tests/funptr-struct-return-xstack.c
new file mode 100644
index 000000000..531def842
--- /dev/null
+++ b/support/regression/tests/funptr-struct-return-xstack.c
@@ -0,0 +1,131 @@
+/** Calls through a pointer to a function that returns a struct or union.
+
+    With stack-auto, the object for the value of each call is on the stack.
+    For mcs51 with --xstack that is the external stack, and the caller
+    removes the hidden pointer to the object from that stack after the call.
+*/
+#include <testfwk.h>
+
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+#if !defined(__SDCC_pdk13) && !defined(__SDCC_pdk14) // Lack of memory
+struct s
+{
+  unsigned char a;
+  int b;
+  unsigned char c;
+};
+
+union u
+{
+  unsigned char a;
+  long b;
+};
+
+struct s gs;
+
+struct s
+mk (void)
+{
+  struct s r;
+  r.a = 0x12;
+  r.b = 0x3456;
+  r.c = 0x78;
+  return r;
+}
+
+union u
+mku (void)
+{
+  union u r;
+  r.b = 0x12345678;
+  return r;
+}
+
+/* The value of the call initializes a variable. */
+struct s
+viaVariable (struct s (*fp) (void))
+{
+  struct s r = fp ();
+  return r;
+}
+
+/* The value of the call is returned. */
+struct s
+viaReturn (struct s (*fp) (void))
+{
+  return fp ();
+}
+
+/* Parameters and another variable are used after the call. */
+int
+viaAssign (struct s (*fp) (void), int x, int y)
+{
+  struct s r;
+  int z = x - y;
+
+  r = fp ();
+  return r.b + z + x;
+}
+
+/* The value of the call is assigned to an object that is not on the stack. */
+void
+toStatic (struct s (*fp) (void))
+{
+  gs = fp ();
+}
+
+long
+viaUnion (union u (*fp) (void))
+{
+  union u r;
+
+  r = fp ();
+  return r.b;
+}
+
+/* The stack pointers must have the same values before and after each call. */
+unsigned int
+manyCalls (struct s (*fp) (void))
+{
+  unsigned char i;
+  unsigned int sum = 0;
+
+  for (i = 0; i < 100; i++)
+    sum += fp ().a;
+  return sum;
+}
+#endif
+#endif
+
+void
+testFunPtrStructReturn (void)
+{
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+#if !defined(__SDCC_pdk13) && !defined(__SDCC_pdk14) // Lack of memory
+  struct s r;
+
+  r = viaVariable (mk);
+  ASSERT (r.a == 0x12);
+  ASSERT (r.b == 0x3456);
+  ASSERT (r.c == 0x78);
+
+  r.b = 0;
+  r = viaReturn (mk);
+  ASSERT (r.a == 0x12);
+  ASSERT (r.b == 0x3456);
+  ASSERT (r.c == 0x78);
+
+  ASSERT (viaAssign (mk, 0x100, 0x30) == 0x3456 + 0xd0 + 0x100);
+
+  gs.b = 0;
+  toStatic (mk);
+  ASSERT (gs.a == 0x12);
+  ASSERT (gs.b == 0x3456);
+  ASSERT (gs.c == 0x78);
+
+  ASSERT (viaUnion (mku) == 0x12345678);
+
+  ASSERT (manyCalls (mk) == 100 * 0x12);
+#endif
+#endif
+}
