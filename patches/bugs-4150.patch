From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Thu, 12 Nov 2026 12:20:24 -0800
Subject: [PATCH] [bugs #4150] Make the declaration of a for statement visible
 in its two expressions

The grammar rule for a for statement with a declaration called
addSymChain() after the controlling expression and the iteration
expression had been parsed. The parser actions for typeof and for &*
call typeofOp(), which resolves the symbols of the operand during the
parse, and the symbol table did not have the loop variable at that
time. For

    for (int *p = a; p != a + 3; p = &*p + 1) { }

the compiler gave error 20 (Undefined identifier 'p'). When an
enclosing scope declared an object named p, typeofOp() bound the
operand to that object. The compiler then generated code that reads
the object of the enclosing scope, and it gave a warning only when the
two types were incompatible. The lexer also looks up identifiers in
the symbol table to tell typedef names from other identifiers, so a
loop variable T that hides a typedef name got a syntax error for
(T) < 3.

The rule now calls addSymChain() in an action that follows the
declaration. The rule for the header of an if or switch statement that
has a declaration and an expression (C2y) called addSymChain() after
the expression, and it is changed in the same way.

The declarators of one declaration are still added together when the
declaration ends, so int *p = a, *q = &*p; gets error 20.

Adds tests/bug-4150.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCC.y                          |  18 +++--
 support/regression/tests/bug-4150.c | 108 ++++++++++++++++++++++++++++
 2 files changed, 120 insertions(+), 6 deletions(-)
 create mode 100644 support/regression/tests/bug-4150.c

diff --git a/src/SDCC.y b/src/SDCC.y
index 79628423f..501e58b9c 100644
--- a/src/SDCC.y
+++ b/src/SDCC.y
@@ -2368,15 +2368,19 @@ else_statement
 
 selection_header
    : expression               { $$ = newNode(NULLOP, NULL, $1); }
-   | declaration expression   {
+   | declaration              {
                                 if (!options.std_c2y)
                                   werror(E_SELECTION_DECLARATION_C2Y);
 
                                 if ($1 && IS_TYPEDEF($1->etype))
                                   allocVariables($1);
                                 ignoreTypedefType = 0;
+                                /* Add the declaration before the expression is parsed. The actions */
+                                /* for typeof and &* look up their operand during the parse. */
                                 addSymChain(&$1);
-                                $$ = newNode(NULLOP, newAst_VALUE(symbolVal($1)), $2);
+                              }
+     expression               {
+                                $$ = newNode(NULLOP, newAst_VALUE(symbolVal($1)), $3);
                               }
    | simple_declaration       {
                                 if (!options.std_c2y)
@@ -2494,7 +2498,7 @@ iteration_statement
                           NestLevel -= LEVEL_UNIT;
                           currBlockno = STACK_POP(blockNum);
                         }
-   | for '(' declaration expression_opt ';' expression_opt ')'
+   | for '(' declaration
                         {
                           if (!options.std_c99)
                             werror (E_FOR_INITAL_DECLARATION_C99);
@@ -2502,9 +2506,11 @@ iteration_statement
                           if ( $3 && IS_TYPEDEF($3->etype))
                             allocVariables ($3);
                           ignoreTypedefType = 0;
+                          /* Add the declaration before the two expressions are parsed. The */
+                          /* actions for typeof and &* look up their operand during the parse. */
                           addSymChain(&$3);
                         }
-     secondary_block
+     expression_opt ';' expression_opt ')' secondary_block
                         {
 
                           noLineno++;
@@ -2515,8 +2521,8 @@ iteration_statement
                           AST_FOR($$,falseLabel) = STACK_POP(breakStack);
                           AST_FOR($$,condLabel)  = STACK_POP(forStack);
                           AST_FOR($$,initExpr)   = 0;
-                          AST_FOR($$,condExpr)   = $4;
-                          AST_FOR($$,loopExpr)   = $6;
+                          AST_FOR($$,condExpr)   = $5;
+                          AST_FOR($$,loopExpr)   = $7;
 
                           /* This continue label is not at the correct location, */
                           /* but we need to create it now for proper binding. The */
diff --git a/support/regression/tests/bug-4150.c b/support/regression/tests/bug-4150.c
new file mode 100644
index 000000000..b575ff24b
--- /dev/null
+++ b/support/regression/tests/bug-4150.c
@@ -0,0 +1,108 @@
+/* bug-4150.c
+   The declaration in the first clause of a for statement was added to the
+   symbol table after the controlling expression and the iteration
+   expression had been parsed. The parser looks up the operand of &* and of
+   typeof during the parse. In these two expressions it reported the loop
+   variable as undefined, or used an object of the same name from an
+   enclosing scope in its place. The declaration in the header of an if or
+   switch statement (C2y) was added after the expression of the header.
+ */
+
+#include <testfwk.h>
+
+#ifdef __SDCC
+#pragma std_c2y
+#elif !defined (__STDC_VERSION__) || __STDC_VERSION__ < 202311L
+#define SKIP_C23
+#endif
+
+static unsigned char buf[3];
+
+/* The loop variables of the tests hide these. */
+static unsigned char *p = buf + 2;
+static long i;
+typedef int T;
+
+static inline unsigned char *
+next (unsigned char *q)
+{
+  return q + 1;
+}
+
+/* Each loop also ends at n == 10, which bounds it when its condition or
+   its iteration expression reads the wrong object. */
+
+void
+testCall (void)
+{
+  unsigned char n = 0;
+
+  for (unsigned char *r = buf; r != buf + 3 && n < 10; r = next (&*r))
+    n++;
+  ASSERT (n == 3);
+}
+
+void
+testIteration (void)
+{
+  unsigned char n = 0;
+
+  for (unsigned char *p = buf; p != buf + 3 && n < 10; p = &*p + 1)
+    n++;
+  ASSERT (n == 3);
+  ASSERT (p == buf + 2);
+}
+
+void
+testCondition (void)
+{
+  unsigned char n = 0;
+
+  for (unsigned char *p = buf; &*p != buf + 3 && n < 10; p++)
+    n++;
+  ASSERT (n == 3);
+  ASSERT (p == buf + 2);
+}
+
+void
+testTypeof (void)
+{
+#ifndef SKIP_C23
+  unsigned char n = 0;
+
+  for (unsigned char i = 0; i < sizeof (typeof (i)) && n < 10; i += (typeof (i))1)
+    n++;
+  ASSERT (n == 1);
+  ASSERT (sizeof (i) == sizeof (long));
+#endif
+}
+
+void
+testTypedefName (void)
+{
+  unsigned char n = 0;
+
+  /* T is the loop variable, and (T) does not start a cast. */
+  for (unsigned char T = 0; (T) < 3 && n < 10; T++)
+    n++;
+  ASSERT (n == 3);
+  ASSERT (sizeof (T) == sizeof (int));
+}
+
+void
+testSelection (void)
+{
+#ifdef __SDCC
+  unsigned char n = 0;
+
+  if (unsigned char *p = buf; &*p == buf)
+    n++;
+  switch (unsigned char *p = buf; &*p == buf)
+    {
+    case 1:
+      n++;
+    }
+  ASSERT (n == 2);
+  ASSERT (p == buf + 2);
+#endif
+}
