From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Tue, 10 Nov 2026 20:36:07 -0800
Subject: [PATCH] [bugs #3843] mcs51: count the size of an instruction that a
 comment follows directly

asmLineNodeFromLineNode() returned before it computed the instruction size when a semicolon followed the mnemonic without a space, so a line such as "nop; nop; nop;" from inline assembler had size 0. The peephole optimizer adds up these sizes to decide whether a label is in range of a short jump. With enough of these lines between a jump and its label, it replaced a long jump by a short one, and the assembler reported "Branching Range Exceeded".

The function now returns at a semicolon only when no mnemonic precedes it.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/main.c                    |  4 +-
 support/regression/tests/bug-3843.c | 58 +++++++++++++++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)
 create mode 100644 support/regression/tests/bug-3843.c

diff --git a/src/mcs51/main.c b/src/mcs51/main.c
index 8912f96f8..f9a901f06 100644
--- a/src/mcs51/main.c
+++ b/src/mcs51/main.c
@@ -884,7 +884,9 @@ asmLineNodeFromLineNode (lineNode *ln)
     }
   *op = '\0';
 
-  if (*p == ';' || *p == ':' || *p == '=')
+  /* a label, an assignment, or a comment without an instruction.
+     In "nop; text" the comment follows the mnemonic directly.  */
+  if (*p == ':' || *p == '=' || (*p == ';' && !*inst))
     return aln;
 
   p = skip_spaces (p);
diff --git a/support/regression/tests/bug-3843.c b/support/regression/tests/bug-3843.c
new file mode 100644
index 000000000..cd65d3e05
--- /dev/null
+++ b/support/regression/tests/bug-3843.c
@@ -0,0 +1,58 @@
+/* bug-3843.c
+   mcs51 assembler error "Branching Range Exceeded". The peephole optimizer
+   counted no bytes for an instruction when a comment followed the mnemonic
+   without a space, as in the inline assembler line "nop; nop; nop;". It then
+   used a short jump over a distance that was out of range.
+ */
+
+#include <testfwk.h>
+
+#ifdef __SDCC_mcs51
+/* The assembler reads everything after the first semicolon as a comment,
+   so this is one nop. */
+#define NOP __asm nop; nop; nop; __endasm
+#else
+#define NOP
+#endif
+
+#define NOP10 NOP; NOP; NOP; NOP; NOP; NOP; NOP; NOP; NOP; NOP
+#define NOP70 NOP10; NOP10; NOP10; NOP10; NOP10; NOP10; NOP10
+
+/* 140 bytes of nop are between each jump and its label. */
+
+static unsigned char
+backward (unsigned char n)
+{
+  unsigned char r = 0;
+
+  do
+    {
+      r += 2;
+      NOP70;
+      NOP70;
+    }
+  while (--n);
+  return r;
+}
+
+static unsigned char
+forward (unsigned char c)
+{
+  unsigned char r = 1;
+
+  if (c)
+    {
+      NOP70;
+      NOP70;
+      r = 2;
+    }
+  return r;
+}
+
+void
+testBug (void)
+{
+  ASSERT (backward (3) == 6);
+  ASSERT (forward (0) == 1);
+  ASSERT (forward (1) == 2);
+}
