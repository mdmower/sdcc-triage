From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Wed, 11 Nov 2026 16:59:26 -0800
Subject: [PATCH] [local #0006] mcs51 peephole: count sjmp as 3 bytes in range
 checks

Rule 257.c replaces "sjmp %5" by "ljmp %6" when the instruction at the
label %5 is an unconditional jump to %6 and %6 is out of range for sjmp.
The ljmp is 1 byte longer than the sjmp.

The optimizer applies one rule to all lines before it applies the next
rule. Rule 112.b is earlier in the file and replaces an ljmp by an sjmp
when labelInRange() accepts the distance. Rules 108.a to 108.e then
join the sjmp with the conditional jump before it. The optimizer does
not check these jumps again. Each line that rule 257.c replaced
afterward between such a jump and its label added 1 byte to the
distance. In

    void h (unsigned char x, unsigned char y) __reentrant
    {
      do
        {
          if (y)
            {
              switch (x)
                {
                case 3: bt2 = 1; break;
                /* 10 more cases of this form */
                }
              return;
            }
          g = 20; g = 21; g = 22;
        }
      while (bt);
      ...
    }

each break is a jump to the return statement, and the return statement
is a jump to the end of the function. Rule 112.b replaced the ljmp of
10 breaks by sjmp, and the loop was then short enough for a jb back to
its start. Rule 257.c replaced the 10 sjmp by ljmp to the end of the
function, and the assembler reported "Branching Range Exceeded" for the
jb, which was 130 bytes from its label.

instructionSize() now returns 3 for an sjmp, which is the size of the
ljmp that can replace it. labelInRange() and labelJTInRange() are the
users of this size. They now accept a distance only if it is still in
range when rule 257.c replaces every sjmp in it. The rules are not
changed.

A jump stays long when its distance is in range with 2 bytes per sjmp
and out of range with 3. That costs 1 byte for an ljmp that could be an
sjmp and 3 bytes for a conditional jump over an ljmp.

Rule 250.a makes a jbc and an sjmp from a jnb and a clr of the same
total size, so the third byte of that sjmp is not counted at the range
checks before the rule is applied. Rule 257.c does not replace that
sjmp, because notInJumpTable() is false for its line, which does not
have an iCode.

Adds tests/jump-range.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/main.c                      |  5 +-
 src/mcs51/peeph.def                   |  2 +
 support/regression/tests/jump-range.c | 81 +++++++++++++++++++++++++++
 3 files changed, 87 insertions(+), 1 deletion(-)
 create mode 100644 support/regression/tests/jump-range.c

diff --git a/src/mcs51/main.c b/src/mcs51/main.c
index f9a901f06..bd60bdecc 100644
--- a/src/mcs51/main.c
+++ b/src/mcs51/main.c
@@ -560,7 +560,10 @@ instructionSize(char *inst, char *op1, char *op2)
   if (ISINST ("lcall")) return 3;
   if (ISINST ("ret")) return 1;
   if (ISINST ("ljmp")) return 3;
-  if (ISINST ("sjmp")) return 2;
+  /* An sjmp is 2 bytes long. Peephole rule 257.c can replace it by an ljmp
+     after labelInRange() has accepted a short jump across it, so it counts
+     with the size of the ljmp. */
+  if (ISINST ("sjmp")) return 3;
   if (ISINST ("rlc")) return 1;
   if (ISINST ("rrc")) return 1;
   if (ISINST ("rl")) return 1;
diff --git a/src/mcs51/peeph.def b/src/mcs51/peeph.def
index 96d8688ec..2069c589d 100644
--- a/src/mcs51/peeph.def
+++ b/src/mcs51/peeph.def
@@ -4276,6 +4276,8 @@ replace restart {
 	; peephole 257.b jumped to %6 directly instead of via %5.
 } if label5IsUncondJumpTo6(), labelInRange(%6), notSame(%5 %6), labelRefCountChange(%5 -1), labelRefCountChange(%6 +1)
 
+// The ljmp is 1 byte longer than the sjmp. For this rule, instructionSize()
+// in main.c counts an sjmp as 3 bytes.
 replace restart {
 	sjmp	%5
 } by {
diff --git a/support/regression/tests/jump-range.c b/support/regression/tests/jump-range.c
new file mode 100644
index 000000000..b1a116d13
--- /dev/null
+++ b/support/regression/tests/jump-range.c
@@ -0,0 +1,81 @@
+/* jump-range.c
+   mcs51 assembler error "Branching Range Exceeded". The peephole optimizer
+   replaced a 2-byte sjmp to a label at which an ljmp is by a 3-byte ljmp to
+   the target of that ljmp. It had accepted a short jump across such places
+   for the smaller code, and the jump was then out of range.
+ */
+
+#include <testfwk.h>
+
+__data unsigned char last;
+__data volatile unsigned char pad;
+unsigned char calls;
+
+static void
+fn (void)
+{
+  calls++;
+}
+
+#define CASE(n) case n: last = n; break;
+#define CALL8 fn (); fn (); fn (); fn (); fn (); fn (); fn (); fn ();
+
+/* Each break jumps to the return statement, and the return statement is a
+   jump to the end of the function. The 40 calls put the end of the function
+   out of the range of a short jump. The parameter on the stack gives the
+   function more than a ret instruction at its end. The jump at the end of
+   the loop goes back across the breaks. The loop is about 120 bytes long on
+   mcs51, and PAD adds 3 bytes per statement. */
+#define FIND(name, PAD) \
+static void \
+name (unsigned char x, unsigned char other) __reentrant \
+{ \
+  do \
+    { \
+      switch (x) \
+        { \
+        default: \
+          x++; \
+          PAD \
+          continue; \
+        CASE (3) CASE (13) CASE (23) CASE (33) CASE (43) CASE (53) \
+        CASE (63) CASE (73) CASE (83) CASE (93) CASE (103) \
+        } \
+      return; \
+    } \
+  while (x); \
+  CALL8 CALL8 CALL8 CALL8 CALL8 \
+  last = other; \
+}
+
+/* The jump was out of range for 6 consecutive loop lengths, so the three
+   loops are 6 bytes apart. */
+FIND (find0, )
+FIND (find2, pad = 1; pad = 2;)
+FIND (find4, pad = 1; pad = 2; pad = 3; pad = 4;)
+
+/* 43 is a case value, 103 is the first case value from 94 upward, and the
+   values from 104 to 255 are not case values. */
+#define CHECK(find) \
+  do \
+    { \
+      last = 0; \
+      calls = 0; \
+      find (43, 7); \
+      ASSERT (last == 43); \
+      find (94, 7); \
+      ASSERT (last == 103); \
+      ASSERT (calls == 0); \
+      find (104, 7); \
+      ASSERT (last == 7); \
+      ASSERT (calls == 40); \
+    } \
+  while (0)
+
+void
+testBug (void)
+{
+  CHECK (find0);
+  CHECK (find2);
+  CHECK (find4);
+}
