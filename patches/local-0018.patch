From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Wed, 18 Nov 2026 05:05:37 -0800
Subject: [PATCH] [local #0018] mcs51: read the top byte of a volatile source
 once when a cast extends the sign

genCast() copies the bytes of the right operand to the result. For a
signed right operand that is narrower than the result, it then loaded
the most significant byte of the right operand into the accumulator to
extend the sign. For a volatile object, that load was a second read of
the byte, and the source reads the object once:

    volatile signed char v8;
    int i;

    i = v8;     /* mov _i,_v8   mov a,_v8   rlc a   subb a,acc   ... */

When an interrupt routine or the hardware changes the object between the
two reads, the copied bytes and the sign bytes of the result are from
different values. A change from -1 to 0 gives 255. The object was read
twice in __data, __idata, __pdata, __xdata, and __code, with every
memory model, and also when the result of the conversion is an operand
of an operation, as in i += v8.

For a volatile right operand, genCast() now loads the most significant
byte into the accumulator, stores the accumulator to the result, and
extends the sign from the accumulator. The code for right operands that
are not volatile does not change.

Adds tests/cast-volatile.c.in. For mcs51, an interrupt routine changes
the object after one instruction of the conversion, and the test repeats
the conversion with the change after each of the first 16 instructions.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/gen.c                             |  19 ++-
 support/regression/tests/cast-volatile.c.in | 148 ++++++++++++++++++++
 2 files changed, 165 insertions(+), 2 deletions(-)
 create mode 100644 support/regression/tests/cast-volatile.c.in

diff --git a/src/mcs51/gen.c b/src/mcs51/gen.c
index ac68c39f9..4361336d3 100644
--- a/src/mcs51/gen.c
+++ b/src/mcs51/gen.c
@@ -13037,6 +13037,7 @@ genCast (iCode * ic)
   operand *right = IC_RIGHT (ic);
   int size, offset;
   bool right_boolean;
+  bool msb_in_acc;
 
   D (emitcode (";", "genCast"));
 
@@ -13204,12 +13205,25 @@ genCast (iCode * ic)
 
   /* so we now know that the size of destination is greater
      than the size of the source */
+  /* The bytes of a volatile source are read once. Its most significant
+     byte is copied through the accumulator, and the sign is extended
+     from the accumulator. */
+  msb_in_acc = AOP (right)->aop_is_volatile && IS_SPEC (rtype) && !SPEC_USIGN (rtype) && AOP_TYPE (right) != AOP_CRY;
+
   /* we move to result for the size of source */
   size = AOP_SIZE (right);
   offset = 0;
   while (size--)
     {
-      opPut(result, opGet (right, offset, FALSE, FALSE), offset);
+      if (!size && msb_in_acc)
+        {
+          MOVA (opGet (right, offset, FALSE, FALSE));
+          opPut(result, "a", offset);
+        }
+      else
+        {
+          opPut(result, opGet (right, offset, FALSE, FALSE), offset);
+        }
       offset++;
     }
 
@@ -13236,7 +13250,8 @@ genCast (iCode * ic)
       bool masktopbyte = IS_BITINT (ctype) && (SPEC_BITINTWIDTH (ctype) % 8) && SPEC_USIGN (ctype);
 
       /* we need to extend the sign :{ */
-      MOVA (opGet (right, AOP_SIZE (right) - 1, FALSE, FALSE));
+      if (!msb_in_acc)
+        MOVA (opGet (right, AOP_SIZE (right) - 1, FALSE, FALSE));
       emitcode ("rlc", "a");
       emitcode ("subb", "a,acc");
       while (size--)
diff --git a/support/regression/tests/cast-volatile.c.in b/support/regression/tests/cast-volatile.c.in
new file mode 100644
index 000000000..52c23bd37
--- /dev/null
+++ b/support/regression/tests/cast-volatile.c.in
@@ -0,0 +1,148 @@
+/** cast-volatile.c
+    Conversions of volatile signed objects to wider types read each byte
+    of the object once.
+
+    mem: __data, __idata, __pdata, __xdata
+ */
+
+#include <testfwk.h>
+
+#include <stdint.h>
+
+#ifdef __SDCC_mcs51
+#include <8052.h>
+#endif
+
+volatile {mem} int8_t v8;
+volatile {mem} int16_t v16;
+
+int16_t i;
+int32_t l;
+
+void
+testValue (void)
+{
+  v8 = -1;
+  i = v8;
+  ASSERT (i == -1);
+  v8 = 127;
+  i = v8;
+  ASSERT (i == 127);
+
+  v8 = -128;
+  l = v8;
+  ASSERT (l == -128);
+  v8 = 1;
+  l = v8;
+  ASSERT (l == 1);
+
+  v16 = -2;
+  l = v16;
+  ASSERT (l == -2);
+  v16 = 0x7f80;
+  l = v16;
+  ASSERT (l == 0x7f80);
+
+  i = 1000;
+  v8 = -100;
+  i += v8;
+  ASSERT (i == 900);
+}
+
+#ifdef __SDCC_mcs51
+/* The program requests the interrupt of timer 2 and leaves the request
+   set, so the service routine runs after each instruction of the program
+   while the interrupt is enabled. After the program writes n to delay,
+   the n-th run of the routine changes the sign of v8 and of v16. The two
+   values of v16 have the same lower byte, because the program reads the
+   two bytes with two instructions. */
+volatile uint8_t delay;
+
+void
+T2_isr (void) __interrupt (5)
+{
+  if (delay && !--delay)
+    {
+      v8 = 0;
+      v16 = 0x0055;
+    }
+}
+
+/* Executes statement, and the objects change after the n-th instruction
+   that follows the write to delay. */
+#define CHANGE_AFTER(n, statement) \
+  do \
+    { \
+      delay = 0; \
+      v8 = -1; \
+      v16 = -171; /* 0xff55 */ \
+      EA = 1; \
+      delay = (n); \
+      statement; \
+      EA = 0; \
+    } \
+  while (0)
+
+/* Each conversion reads the object in fewer instructions. */
+#define INSTRUCTIONS 16
+
+/* bits of seen */
+#define BEFORE 1 /* the conversion read the object before the change */
+#define AFTER 2  /* the conversion read the object after the change */
+#endif
+
+/* Conversions that read the upper byte of the object once for the value
+   and once more for the sign give 255 or 65365 when the object changes
+   between the two reads. In each loop, the object changes before the
+   read for n = 1 and after the read for n = INSTRUCTIONS, which seen
+   records. */
+void
+testReadOnce (void)
+{
+#ifdef __SDCC_mcs51
+  uint8_t n, seen;
+
+  ET2 = 1;
+  TF2 = 1;
+
+  seen = 0;
+  for (n = 1; n <= INSTRUCTIONS; n++)
+    {
+      CHANGE_AFTER (n, i = v8);
+      ASSERT (i == -1 || i == 0);
+      seen |= i ? BEFORE : AFTER;
+    }
+  ASSERT (seen == (BEFORE | AFTER));
+
+  seen = 0;
+  for (n = 1; n <= INSTRUCTIONS; n++)
+    {
+      CHANGE_AFTER (n, l = v8);
+      ASSERT (l == -1 || l == 0);
+      seen |= l ? BEFORE : AFTER;
+    }
+  ASSERT (seen == (BEFORE | AFTER));
+
+  seen = 0;
+  for (n = 1; n <= INSTRUCTIONS; n++)
+    {
+      CHANGE_AFTER (n, l = v16);
+      ASSERT (l == -171 || l == 0x0055);
+      seen |= l < 0 ? BEFORE : AFTER;
+    }
+  ASSERT (seen == (BEFORE | AFTER));
+
+  seen = 0;
+  for (n = 1; n <= INSTRUCTIONS; n++)
+    {
+      i = 0;
+      CHANGE_AFTER (n, i += v8);
+      ASSERT (i == -1 || i == 0);
+      seen |= i ? BEFORE : AFTER;
+    }
+  ASSERT (seen == (BEFORE | AFTER));
+
+  ET2 = 0;
+  TF2 = 0;
+#endif
+}
