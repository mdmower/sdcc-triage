From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Mon, 9 Nov 2026 23:07:46 -0800
Subject: [PATCH] [bugs #2997] Keep the return value of an inlined __critical
 function

When a __critical function is inlined its body is wrapped in a CRITICAL
node. That node was created without a source location, so it had the
parser's current nesting level, not the level of the call, and
fixupInline took the base level for the whole inlined body from it. For
a call inside a nested block the return value was then assigned to one
variable and read from another. The value was lost and warning 84 (may
be used before initialization) appeared.

Adds tests/bug-2997.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCast.c                       |  9 ++++-
 support/regression/tests/bug-2997.c | 52 +++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+), 1 deletion(-)
 create mode 100644 support/regression/tests/bug-2997.c

diff --git a/src/SDCCast.c b/src/SDCCast.c
index 6faf7af38..3dd255bfb 100644
--- a/src/SDCCast.c
+++ b/src/SDCCast.c
@@ -8020,7 +8020,14 @@ expandInlineFuncs (ast * tree, ast * block)
           /* {{inline_function_code}}, retsym                         */
           tree->opval.op = ',';
           if (IFFUNC_ISCRITICAL (func->type))
-            inlinetree = newNode (CRITICAL, inlinetree, NULL);
+            {
+              /* The new node must be at the level of the block it wraps:
+                 fixupInline below takes the base level from it. */
+              ast *body = inlinetree;
+
+              inlinetree = newNode (CRITICAL, body, NULL);
+              copyAstLoc (inlinetree, body);
+            }
           tree->left = inlinetree;
           if (retsym)
               tree->right = newAst_VALUE (symbolVal (retsym));
diff --git a/support/regression/tests/bug-2997.c b/support/regression/tests/bug-2997.c
new file mode 100644
index 000000000..7d434d8b5
--- /dev/null
+++ b/support/regression/tests/bug-2997.c
@@ -0,0 +1,52 @@
+/* bug-2997.c
+   The value returned by an inlined __critical function was lost when the
+   call was inside a nested block. The CRITICAL node wrapped around the
+   inlined body was created at the wrong nesting level, so the return value
+   was assigned to one variable and read from another ("may be used before
+   initialization").
+ */
+
+#include <testfwk.h>
+
+volatile int cnt;
+int cnt0;
+
+static inline int
+cnt_get (void) __critical
+{
+  return cnt;
+}
+
+static inline unsigned char
+diff_or_sum (unsigned char a, unsigned char b) __critical
+{
+  if (a > b)
+    return a - b;
+  return a + b;
+}
+
+void
+testBug (void)
+{
+  unsigned char i;
+
+  cnt = 0x1234;
+  cnt0 = 0x1200;
+
+  for (i = 0; i < 3; i++)
+    {
+      if (i == 1)
+        {
+          if ((cnt_get () - cnt0) >= 1)
+            cnt0++;
+          ASSERT (cnt0 == 0x1201);
+        }
+      else if (i == 2)
+        {
+          cnt = 7;
+          ASSERT (cnt_get () == 7);
+          ASSERT (diff_or_sum (5, 3) == 2);
+          ASSERT (diff_or_sum (3, 5) == 8);
+        }
+    }
+}
