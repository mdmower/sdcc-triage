From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Thu, 12 Nov 2026 07:31:22 -0800
Subject: [PATCH] [bugs #3393] Emit a designated union alternative that follows
 a nested anonymous union

The data image of a struct or union is emitted by a walk over its member
list, into which promoteAnonStructs() promotes the members of anonymous
structs and unions. For a union that is initialized through a designated
member of another alternative than the first, designatedAlternative()
looked only at the row of promoted members that follows the member the
union starts at. When the first alternative has an anonymous union of
its own and members after it, those members separate that row from the
other alternatives of the outer union. The struct of the ticket is an
example.

    struct W { char a;
               union { struct { union { char p;
                                        struct { char x, y; }; };
                                char r; };
                       struct { char s, t, u; }; };
               char z; };
    const struct W w = {.a = 1, .t = 9, .z = 4};

The member list is a, p, x, y, r, s, t, u, and z. The row after p is x
and y, so the initializer of t was dropped, and the image was
01 00 00 00 04. An object that is a union itself and has such a first
alternative lost a designated initializer in this way too. Objects that
are initialized by code were not affected.

designatedAlternative() now also looks at each union that starts at the
member, up to the end that promoteAnonStructs() marked (anonopen,
anonclose) or, for an object that is a union, up to the end of the
member list. It takes the member of another alternative when the
initializer of that member is the only one in the union. A list with
more initializers for the union can name two alternatives, of which the
one written later counts, and the reordered list does not have that
order. The image for such a list stays as it was. This includes a list
with several designated members of one alternative.

bug-3393-designated.c had the checks of the data image for this struct
under "#if 0". They are enabled. bug-3393-nested.c has more cases.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCglue.c                                | 113 +++++++++++-
 .../regression/tests/bug-3393-designated.c    |  19 +-
 support/regression/tests/bug-3393-nested.c    | 174 ++++++++++++++++++
 3 files changed, 284 insertions(+), 22 deletions(-)
 create mode 100644 support/regression/tests/bug-3393-nested.c

diff --git a/src/SDCCglue.c b/src/SDCCglue.c
index 4232d9540..105170ea8 100644
--- a/src/SDCCglue.c
+++ b/src/SDCCglue.c
@@ -1098,6 +1098,28 @@ fieldHasIval (symbol *field)
   return !(IS_BITFIELD (field->type) && SPEC_BUNNAMED (field->etype));
 }
 
+/*-----------------------------------------------------------------*/
+/* anonLast - promoteAnonStructs() replaces an anonymous struct or */
+/*   union by its members and marks the first and the last of      */
+/*   them. Return the last member of the one that starts at SFLDS: */
+/*   of the outermost one for LEVEL 0, of the one that starts      */
+/*   within it at the same member for LEVEL 1, and so on. That is  */
+/*   SFLDS itself when fewer of them start there.                  */
+/*-----------------------------------------------------------------*/
+static symbol *
+anonLast (symbol *sflds, int level)
+{
+  int depth = 0;
+
+  for ( ; sflds; sflds = sflds->next)
+    {
+      depth += sflds->anonopen - sflds->anonclose;
+      if (depth <= level)
+        break;
+    }
+  return sflds;
+}
+
 /*-----------------------------------------------------------------*/
 /* designatedAlternative - an anonymous union is initialized       */
 /*   through its first alternative, which is what the walk in      */
@@ -1105,14 +1127,19 @@ fieldHasIval (symbol *field)
 /*   another one instead ({.d = 5}), and reorderIlistIval() fills  */
 /*   a promoted member's slot only in that case. If the union      */
 /*   starting at SFLDS has one, return that member, its            */
-/*   initializer, and the field the union ends before.             */
+/*   initializer, and the field the union ends before. ISUNION is  */
+/*   true when SFLDS is the first member of a union type, which is */
+/*   then searched like an anonymous union that ends with the      */
+/*   member list. The walk keeps KEPT between the calls.           */
 /*-----------------------------------------------------------------*/
 static symbol *
-designatedAlternative (symbol *sflds, initList *iloop, initList **ilist, symbol **after)
+designatedAlternative (symbol *sflds, bool isunion, initList *iloop, initList **ilist, symbol **after, symbol **kept)
 {
   symbol *f, *desig = NULL;
   initList *desigilist = NULL;
+  initList *firstilist = iloop;
   int base = -1;
+  int level;
 
   for (f = sflds; f; f = f->next)
     {
@@ -1137,11 +1164,81 @@ designatedAlternative (symbol *sflds, initList *iloop, initList **ilist, symbol
     }
 
   /* only when sflds is where that union starts */
-  if (!desig || base != (int) sflds->offset)
-    return NULL;
-
+  if (base != (int) sflds->offset)
+    desig = NULL;
   *ilist = desigilist;
   *after = f;
+
+  /* The loop above looks at the row of marked members that follows sflds.
+     That row is not all of a union whose first alternative has an
+     anonymous union of its own and members after it. For
+       union { struct { union { char p; char q; }; char r; }; char s; }
+     the members are p, q, r, and s, and the row ends before r. So look at
+     each union that starts at sflds, from the outermost one, up to the end
+     that promoteAnonStructs() marked, for the first one that has an
+     initializer in its other alternatives. The member of that initializer
+     is the alternative when the union has no other initializer and the row
+     gave none. Any other set of initializers can name two alternatives.
+     The one written later then replaces the other (C11 6.7.9p19), and the
+     reordered list does not have the order in which they were written. So
+     the result of the row stands, and the unions within that union are not
+     searched this way, up to its last member *kept. */
+  for (f = sflds; f && f != *kept; f = f->next)
+    ;
+  if (f)
+    return desig;
+
+  for (level = isunion ? -1 : 0; level < (int) sflds->anonopen; level++)
+    {
+      symbol *head = anonLast (sflds, level + 1);     /* the end of the first alternative */
+      symbol *last = level < 0 ? NULL : anonLast (sflds, level);
+      symbol *other = NULL;
+      initList *otherilist = NULL;
+      int nfirst = 0, nother = 0;
+      bool infirst = true;
+
+      iloop = firstilist;
+      for (f = sflds; ; f = f->next)
+        {
+          if (fieldHasIval (f))
+            {
+              /* in a struct, the member after the first one is not marked */
+              if (!infirst && !f->anonunionalias)
+                {
+                  nother = 0;
+                  break;
+                }
+              if (iloop && iloop->type != INIT_HOLE)
+                {
+                  if (infirst)
+                    nfirst++;
+                  else
+                    {
+                      nother++;
+                      other = f;
+                      otherilist = iloop;
+                    }
+                }
+              iloop = iloop ? iloop->next : NULL;
+            }
+          if (f == head)
+            infirst = false;
+          if (f == last || !f->next)
+            break;
+        }
+      if (!nother)
+        continue;
+
+      if (!desig && nother == 1 && !nfirst && !IS_BITFIELD (other->type))
+        {
+          *ilist = otherilist;
+          *after = f->next;
+          return other;
+        }
+      *kept = f;
+      break;
+    }
+
   return desig;
 }
 
@@ -1232,13 +1329,17 @@ printIvalStruct (symbol *sym, sym_link *type, initList *ilist, struct dbuf_s *oB
         sflds = sflds->next;
 
       unsigned int written = 0;     /* bytes emitted = offset of the next byte */
+      bool isunion = SPEC_STRUCT (type)->type == UNION;       /* sflds is the first member of a union */
+      symbol *kept = NULL;          /* for designatedAlternative() */
 
       while (sflds)
         {
           unsigned int oldoffset = sflds->offset;
           initList *desigilist = NULL;
           symbol *after = NULL;
-          symbol *desig = designatedAlternative (sflds, iloop, &desigilist, &after);
+          symbol *desig = designatedAlternative (sflds, isunion, iloop, &desigilist, &after, &kept);
+
+          isunion = false;
 
           if (desig)
             {
diff --git a/support/regression/tests/bug-3393-designated.c b/support/regression/tests/bug-3393-designated.c
index f5a4baf4b..60410cbdb 100644
--- a/support/regression/tests/bug-3393-designated.c
+++ b/support/regression/tests/bug-3393-designated.c
@@ -183,25 +183,12 @@ testDesignatedNestedUnion (void)
 
       /* At file scope the object is built by printIvalStruct() instead, on
          the targets that emit an initialized global as a data image. That
-         walks the flat member list too, and takes a run of members promoted
-         out of an anonymous union for a whole union; under nesting the run
-         is only part of one, so the designated alternative goes unrecognized
-         and its value is dropped. The image reads 01 00 00 00 04 where
-         01 00 09 00 04 is right. The members outside the union are placed
-         correctly either way, so they are checked here. */
+         walks the flat member list too, in which r separates s, t, and u from
+         p, the member the outer union starts at. The image is
+         01 00 09 00 04. */
       ASSERT (gt.a == 1);
       ASSERT (gt.z == 4);
-#if 0 /* still fails wherever an initialized global becomes a data image -
-         z80, stm8 and hc08 among others. The targets that generate code for
-         one instead, mcs51 and pdk14 among them, already get this right, so
-         the checks are compiled out rather than excluded per port.
-         Not addressed here: it predates this series, and the union's extent
-         cannot be recovered from the flat list at all - y sits at the byte
-         where the first alternative ends, so no scan over member offsets can
-         tell that it belongs to the union. Fixing it means letting the
-         initializer walk see the nesting the flattening discards. */
       ASSERT (gt.t == 9);
       ASSERT (gt.s == 0);
       ASSERT (gt.u == 0);
-#endif
 }
diff --git a/support/regression/tests/bug-3393-nested.c b/support/regression/tests/bug-3393-nested.c
new file mode 100644
index 000000000..467d4cbdd
--- /dev/null
+++ b/support/regression/tests/bug-3393-nested.c
@@ -0,0 +1,174 @@
+/* bug-3393-nested.c
+   A designated initializer names a member of an alternative of an anonymous
+   union, and the first alternative of that union has an anonymous union of
+   its own with members after it.
+
+   The members of anonymous structs and unions are promoted into the
+   enclosing struct. In its member list, the members after the inner union
+   separate the members of the other alternatives from the member that the
+   outer union starts at. The data image of the object has the designated
+   value, and zeros in the rest of the union.
+
+   The constant objects are emitted as data, the automatic one is
+   initialized by code.
+ */
+
+#include <testfwk.h>
+
+/* the struct of the ticket */
+struct W
+{
+  char a;
+  union
+  {
+    struct
+    {
+      union
+      {
+        char p;
+        struct
+        {
+          char x;
+          char y;
+        };
+      };
+      char r;
+    };
+    struct
+    {
+      char s;
+      char t;
+      char u;
+    };
+  };
+  char z;
+};
+
+/* the object is a union itself */
+union V
+{
+  struct
+  {
+    union
+    {
+      char p;
+      char q;
+    };
+    char r;
+  };
+  char c[2];
+};
+
+/* the inner union is not the first member of its alternative */
+struct Y
+{
+  union
+  {
+    struct
+    {
+      char a;
+      union
+      {
+        char b;
+        char c;
+      };
+      char r;
+    };
+    struct
+    {
+      char s;
+      char t;
+      char u;
+    };
+  };
+  char z;
+};
+
+/* three unions that start at the same member */
+struct Z
+{
+  int a;
+  union
+  {
+    struct
+    {
+      union
+      {
+        struct
+        {
+          union
+          {
+            char p;
+            char q;
+          };
+          char r;
+        };
+        char m[2];
+      };
+      int n;
+    };
+    struct
+    {
+      int s;
+      long t;
+    };
+  };
+  char z;
+};
+
+const struct W cwt = {.a = 1, .t = 9, .z = 4};
+const struct W cwu = {.u = 6};
+const struct W cwa[2] = {{.s = 5}, {.a = 1, .t = 9, .z = 4}};
+struct W gwa[2] = {{.t = 9}, {.a = 1, .u = 6, .z = 4}};
+/* initializers for the first alternative */
+const struct W cwy = {.a = 1, .y = 7, .r = 3, .z = 4};
+const struct W cwp = {1, 2, 3, 4};
+
+const union V cvc = {.c = {1, 2}};
+const union V cvq = {.q = 1, .r = 2};
+
+const struct Y cyt = {.t = 9, .z = 4};
+const struct Y cyc = {.a = 5, .c = 1, .r = 2, .z = 4};
+
+const struct Z czt = {.a = 0x0102, .t = 0x0a0b0c0dL, .z = 4};
+const struct Z czm = {.a = 0x0102, .m = {5, 6}, .z = 4};
+const struct Z czq = {.a = 0x0102, .q = 7, .r = 8, .n = 0x0304, .z = 4};
+
+void
+testNested (void)
+{
+  struct W w = {.a = 1, .t = 9, .z = 4};
+
+  ASSERT (cwt.a == 1 && cwt.s == 0 && cwt.t == 9 && cwt.u == 0 && cwt.z == 4);
+  ASSERT (cwu.a == 0 && cwu.s == 0 && cwu.t == 0 && cwu.u == 6 && cwu.z == 0);
+  ASSERT (cwa[0].s == 5 && cwa[0].t == 0 && cwa[0].z == 0);
+  ASSERT (cwa[1].a == 1 && cwa[1].t == 9 && cwa[1].z == 4);
+  ASSERT (gwa[0].t == 9 && gwa[0].u == 0 && gwa[0].z == 0);
+  ASSERT (gwa[1].a == 1 && gwa[1].u == 6 && gwa[1].z == 4);
+  ASSERT (w.a == 1 && w.s == 0 && w.t == 9 && w.u == 0 && w.z == 4);
+
+  ASSERT (cwy.a == 1 && cwy.x == 0 && cwy.y == 7 && cwy.r == 3 && cwy.z == 4);
+  ASSERT (cwp.a == 1 && cwp.p == 2 && cwp.y == 0 && cwp.r == 3 && cwp.z == 4);
+}
+
+void
+testUnionObject (void)
+{
+  ASSERT (cvc.c[0] == 1 && cvc.c[1] == 2);
+  ASSERT (cvq.q == 1 && cvq.r == 2);
+}
+
+void
+testInnerNotFirst (void)
+{
+  ASSERT (cyt.s == 0 && cyt.t == 9 && cyt.u == 0 && cyt.z == 4);
+  ASSERT (cyc.a == 5 && cyc.c == 1 && cyc.r == 2 && cyc.z == 4);
+}
+
+void
+testLevels (void)
+{
+  ASSERT (czt.a == 0x0102 && czt.s == 0 && czt.t == 0x0a0b0c0dL && czt.z == 4);
+  ASSERT (czm.a == 0x0102 && czm.m[0] == 5 && czm.m[1] == 6 && czm.n == 0 && czm.z == 4);
+  ASSERT (czq.a == 0x0102 && czq.q == 7 && czq.r == 8 && czq.n == 0x0304 && czq.z == 4);
+}
