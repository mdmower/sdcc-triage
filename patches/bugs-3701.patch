diff --git a/src/SDCCsymt.c b/src/SDCCsymt.c
index d4337dfae..b9ac44874 100644
--- a/src/SDCCsymt.c
+++ b/src/SDCCsymt.c
@@ -1594,7 +1594,7 @@ addSymChain (symbol **symHead)
         {
           symbol *csym;
           bool declaration_with_no_linkage_visible =
-            (csym = findSymWithLevel (SymbolTab, sym)) && csym->level && !IS_STATIC (csym->etype) && !IS_EXTERN (csym->type);
+            (csym = findSymWithLevel (SymbolTab, sym)) && csym->level && !IS_STATIC (csym->etype) && !IS_EXTERN (csym->etype);
 
           long saveLevel = sym->level;
           sym->level = 0;
@@ -1629,8 +1629,9 @@ addSymChain (symbol **symHead)
         {
           /* if not formal parameter and not in file scope
              then show symbol redefined error
-             else check if symbols have compatible types */
-          if (!sym->_isparm && sym->level > 0)
+             else check if symbols have compatible types.
+             Identifiers that have linkage can be declared in a block more than once. */
+          if (!sym->_isparm && sym->level > 0 && !(IS_EXTERN (csym->etype) && IS_EXTERN (sym->etype) && !sym->ival))
             error = 1;
           else
             {
@@ -1717,6 +1718,17 @@ addSymChain (symbol **symHead)
               continue;
             }
 
+          /* In a block, the symbol of the first declaration stays in the symbol table with
+             the composite type. Take the symbol of this declaration out of the chain. */
+          if (!sym->_isparm && sym->level > 0)
+            {
+              symPtrPtr = symHead;
+              while (*symPtrPtr != sym)
+                symPtrPtr = &(*symPtrPtr)->next;
+              *symPtrPtr = sym->next;
+              continue;
+            }
+
           if (FUNC_BANKED (csym->type) || FUNC_BANKED (sym->type))
             {
               if (FUNC_NONBANKED (csym->type) || FUNC_NONBANKED (sym->type))
diff --git a/support/regression/tests/bug-3701.c b/support/regression/tests/bug-3701.c
new file mode 100644
index 000000000..352d728c2
--- /dev/null
+++ b/support/regression/tests/bug-3701.c
@@ -0,0 +1,108 @@
+/* bug-3701.c
+   Identifiers that have linkage could not be declared in a block more than
+   once. The second declaration of an object or of a function got error 91,
+   also when a macro declared the object each time it was used.
+ */
+
+#include <testfwk.h>
+
+#include <stdint.h>
+
+const uint8_t d0[2] = {1, 2};
+const uint8_t d1[1] = {3};
+const uint8_t *name_data[2] = {d0, d1};
+
+#define NAME(i) extern const uint8_t *name_data[]; p = name_data[i]
+
+static uint8_t
+byMacro (void)
+{
+  const uint8_t *p;
+  uint8_t sum;
+
+  NAME (0);
+  sum = p[1];
+  NAME (1);
+  sum += p[0];
+
+  return sum;
+}
+
+static int
+arrays (void)
+{
+  extern const uint8_t *name_data[];
+  extern const uint8_t *name_data[];
+  extern int values[];
+  extern int values[3];
+  extern int values[];
+
+  return name_data[0][0] + values[1] + sizeof (values) / sizeof (values[0]);
+}
+
+void bump (void);
+
+static int
+objects (void)
+{
+  extern int counter, counter;
+  extern int counter;
+
+  counter = 5;
+  extern int counter;
+  counter++;
+  bump ();
+  extern int counter;
+
+  return counter;
+}
+
+static int
+hidden (void)
+{
+  int counter = 1;
+
+  {
+    extern int counter;
+    extern int counter;
+    counter = 20;
+  }
+
+  return counter;
+}
+
+static int
+functions (void)
+{
+  int add (int, int);
+  extern int add (int a, int b);
+  int add (int, int);
+
+  return add (3, 4);
+}
+
+int values[3] = {7, 8, 9};
+int counter;
+
+void
+bump (void)
+{
+  counter++;
+}
+
+int
+add (int a, int b)
+{
+  return a + b;
+}
+
+void
+testBug (void)
+{
+  ASSERT (byMacro () == 5);
+  ASSERT (arrays () == 12);
+  ASSERT (objects () == 7);
+  ASSERT (hidden () == 1);
+  ASSERT (counter == 20);
+  ASSERT (functions () == 7);
+}
diff --git a/support/valdiag/tests/bug-3701.c b/support/valdiag/tests/bug-3701.c
new file mode 100644
index 000000000..77199f2cf
--- /dev/null
+++ b/support/valdiag/tests/bug-3701.c
@@ -0,0 +1,94 @@
+/* bug-3701.c
+
+   Identifiers that have linkage can be declared in a block more than once.
+   The types have to be compatible, and identifiers without linkage cannot
+   be declared again.
+ */
+
+#ifdef TEST1
+const char *const names[2] = {"a", "b"};
+
+char f(void)
+{
+  extern const char *const names[];
+  extern const char *const names[];
+  extern int i, i;
+  extern int i;
+
+  return names[i][0];
+}
+#endif
+
+#ifdef TEST2
+int f(void)
+{
+  int g(int);
+  extern int g(int);
+  int g(int);
+
+  return g(1);
+}
+#endif
+
+#ifdef TEST3
+int a[2];
+
+int f(void)
+{
+  extern int a[];
+  {
+    extern int a[];
+    a[0]++;
+  }
+  return a[1];
+}
+#endif
+
+#ifdef TEST4
+int f(void)
+{
+  extern int i; /* IGNORE */
+  extern char i; /* ERROR */
+
+  return i; /* IGNORE */
+}
+#endif
+
+#ifdef TEST5
+int f(void)
+{
+  extern int a[2]; /* IGNORE */
+  extern int a[3]; /* ERROR */
+
+  return a[0]; /* IGNORE */
+}
+#endif
+
+#ifdef TEST6
+int f(void)
+{
+  int i; /* IGNORE */
+  extern int i; /* ERROR */
+
+  return i; /* IGNORE */
+}
+#endif
+
+#ifdef TEST7
+int f(void)
+{
+  extern int i; /* IGNORE */
+  int i; /* ERROR */
+
+  return i; /* IGNORE */
+}
+#endif
+
+#ifdef TEST8
+int f(int i) /* IGNORE */
+{
+  extern int i; /* ERROR */
+
+  return i; /* IGNORE */
+}
+#endif
