From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Mon, 9 Nov 2026 22:29:23 -0800
Subject: [PATCH] [bugs #3885] mcs51: keep the stack balanced when pushing a
 struct through a busy pointer register

The code that pushes a struct argument by value (IPUSH_VALUE_AT_ADDRESS)
reads it through r0 or r1. When both were in use, getFreePtr saved the
register it chose with a push, which left it on the stack underneath the
argument bytes. It was never popped, so after the call the registers
that had been saved were restored one slot off and the stack pointer
stayed one byte too high. For IPUSH and PCALL getFreePtr already saves
the register in B instead. Do the same here.

Seen with --stack-auto, where register pressure is higher. Re-enables
tests/dynamiccstructret.c.in for mcs51 with --stack-auto.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/gen.c                                 | 4 ++--
 support/regression/tests/dynamiccstructret.c.in | 2 --
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/mcs51/gen.c b/src/mcs51/gen.c
index de1c29cfe..fead30fb7 100644
--- a/src/mcs51/gen.c
+++ b/src/mcs51/gen.c
@@ -473,7 +473,7 @@ getFreePtr (iCode * ic, asmop * aop, bool result)
   if (!r0iu)
     {
       /* push it if not already pushed */
-      if ((ic->op == IPUSH) || (ic->op == PCALL))
+      if ((ic->op == IPUSH) || (ic->op == IPUSH_VALUE_AT_ADDRESS) || (ic->op == PCALL))
         {
           MOVB (REG_WITH_INDEX (R0_IDX)->dname);
           R0INB++;
@@ -495,7 +495,7 @@ getFreePtr (iCode * ic, asmop * aop, bool result)
   if (!r1iu)
     {
       /* push it if not already pushed */
-      if ((ic->op == IPUSH) || (ic->op == PCALL))
+      if ((ic->op == IPUSH) || (ic->op == IPUSH_VALUE_AT_ADDRESS) || (ic->op == PCALL))
         {
           MOVB (REG_WITH_INDEX (R1_IDX)->dname);
           R1INB++;
diff --git a/support/regression/tests/dynamiccstructret.c.in b/support/regression/tests/dynamiccstructret.c.in
index 9b5f679ca..ded44770b 100644
--- a/support/regression/tests/dynamiccstructret.c.in
+++ b/support/regression/tests/dynamiccstructret.c.in
@@ -49,7 +49,6 @@ struct s2 fret3 (struct s1 p) __dynamicc
 void testDynamicC(void)
 {
 #if !defined(__SDCC_hc08) && !defined(__SDCC_s08) // struct return not yet supported
-#if !defined(__SDCC_mcs51) || !defined(__SDCC_STACK_AUTO) // Bug #3885
   struct s1 s1;
   struct s2 s2;
   fret1 (VAL2);
@@ -62,6 +61,5 @@ void testDynamicC(void)
   ASSERT (s2.i == ({rtype})VAL1);
   ASSERT (s2.c == 'B');
 #endif
-#endif
 }
 
