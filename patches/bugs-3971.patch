From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Tue, 10 Nov 2026 02:44:03 -0800
Subject: [PATCH] [bugs #3971] Fix crash on a string literal plus an offset in
 a static initializer

constExprValue() recognized a string literal by the type of the node
alone. The sum "AAA" + 3 has a copy of the literal's array type, so the
'+' node was taken for the literal and its operator was read as a
pointer to a value, which crashed the compiler. The crash occurred on
all ports. On mcs51 it occurred for const objects in every model and for
initialized objects in xdata.

Only symbol value nodes count as string literals now, and the sum is
handled by the pointer-plus-constant case of initPointer(). The value
made there keeps the literal's symbol, and printIvalCharPtr() enters the
literal in ccpStr under its own name rather than as "(__str_0 + 3)", so
that emitStaticSeg() emits the string when a const object refers to it
with an offset.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCast.c                       |  2 +-
 src/SDCCglue.c                      | 18 +++++++---
 support/regression/tests/bug-3971.c | 54 +++++++++++++++++++++++++++++
 3 files changed, 69 insertions(+), 5 deletions(-)
 create mode 100644 support/regression/tests/bug-3971.c

diff --git a/src/SDCCast.c b/src/SDCCast.c
index 7019ef869..47c596bd8 100644
--- a/src/SDCCast.c
+++ b/src/SDCCast.c
@@ -2228,7 +2228,7 @@ constExprValue (ast * cexpr, int check)
     {
       /* then check if this is a literal array
          in code segment */
-      if (SPEC_SCLS (cexpr->etype) == S_CODE && SPEC_CVAL (cexpr->etype).v_char && IS_ARRAY (cexpr->ftype))
+      if (IS_AST_SYM_VALUE (cexpr) && SPEC_SCLS (cexpr->etype) == S_CODE && SPEC_CVAL (cexpr->etype).v_char && IS_ARRAY (cexpr->ftype))
         {
           value *val = valFromType (cexpr->ftype);
           SPEC_SCLS (val->etype) = S_LITERAL;
diff --git a/src/SDCCglue.c b/src/SDCCglue.c
index e3552d019..b1b2a5a12 100644
--- a/src/SDCCglue.c
+++ b/src/SDCCglue.c
@@ -570,7 +570,11 @@ initPointer (initList *ilist, sym_link *toType, int showError)
       (IS_ARRAY (expr->left->ftype) || IS_PTR (expr->left->ftype)) &&
       compareType (toType, expr->left->ftype, false) && IS_AST_LIT_VALUE (expr->right))
     {
-      return valForCastAggr (expr->left, expr->left->ftype, expr->right, expr->opval.op);
+      val = valForCastAggr (expr->left, expr->left->ftype, expr->right, expr->opval.op);
+      /* an offset into a string literal: remember the literal, it has to be emitted too */
+      if (val && AST_SYMBOL (expr->left)->isstrlit)
+        val->sym = AST_SYMBOL (expr->left);
+      return val;
     }
 
   /* (char *)(expr1) */
@@ -1645,10 +1649,16 @@ printIvalCharPtr (symbol *sym, sym_link *type, value *val, struct dbuf_s *oBuf)
   int size = 0;
   char *p;
 
-  if (val && !!(p = (char *) malloc (strlen (val->name) + 1)))
+  if (val)
     {
-      strcpy (p, val->name);
-      addSet (&ccpStr, p);
+      /* a string literal goes by its own name; val->name can be an offset into it */
+      const char *name = (val->sym && val->sym->isstrlit) ? val->sym->name : val->name;
+
+      if (!!(p = (char *) malloc (strlen (name) + 1)))
+        {
+          strcpy (p, name);
+          addSet (&ccpStr, p);
+        }
     }
 
   /* PENDING: this is _very_ mcs51 specific, including a magic
diff --git a/support/regression/tests/bug-3971.c b/support/regression/tests/bug-3971.c
new file mode 100644
index 000000000..9f0154dee
--- /dev/null
+++ b/support/regression/tests/bug-3971.c
@@ -0,0 +1,54 @@
+/* bug-3971.c
+   A string literal plus an offset in a static initializer ("AAA" + 3)
+   crashed the compiler: the sum has the type of the string literal, so
+   constExprValue() took the '+' node for the literal itself and read a
+   symbol out of it.
+ */
+
+#include <testfwk.h>
+
+struct s
+{
+  const char *a;
+  const char *b;
+  const char *c;
+  const char *d;
+};
+
+#ifdef __SDCC_mcs51
+__xdata char inXdata[4];
+__data char inData[4];
+#else
+char inXdata[4];
+char inData[4];
+#endif
+
+struct s vars = { "ABC" + 1, inXdata, inData };
+const struct s consts = { "DEF" + 2, 1 + "GHI", "JKL", "MNO" + 3 };
+const char *ptr = "PQR" + 3;
+const char * const constPtr = "STU" + 1;
+
+void
+testBug (void)
+{
+  ASSERT (vars.a[-1] == 'A');
+  ASSERT (vars.a[0] == 'B');
+  ASSERT (vars.a[1] == 'C');
+  ASSERT (vars.a[2] == 0);
+  ASSERT (vars.b == inXdata);
+  ASSERT (vars.c == inData);
+  ASSERT (vars.d == 0);
+
+  ASSERT (consts.a[-2] == 'D');
+  ASSERT (consts.a[0] == 'F');
+  ASSERT (consts.b[-1] == 'G');
+  ASSERT (consts.b[0] == 'H');
+  ASSERT (consts.c[0] == 'J');
+  ASSERT (consts.d[-1] == 'O');
+  ASSERT (consts.d[0] == 0);
+
+  ASSERT (ptr[-3] == 'P');
+  ASSERT (ptr[0] == 0);
+  ASSERT (constPtr[-1] == 'S');
+  ASSERT (constPtr[0] == 'T');
+}
