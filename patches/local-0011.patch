From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Fri, 13 Nov 2026 11:02:02 -0800
Subject: [PATCH] [local #0011] Evaluate the width of a bit-field once

The two member_declarator rules called constExprValue twice with the
tree of the width. constExprValue decorates the tree and continues with
the tree that decorateType returns. For a conditional operator with a
constant condition and for a generic selection, decorateType returns the
operand that is selected, and the root that the rule has is marked as
decorated and does not have a type. The second call got that root.
constExprValue then stopped with a validateLink internal error at
SPEC_SCLS (cexpr->etype), or it reported error 2 (Initializer element is
not a constant expression) where it tests for a symbol node first:

    struct s { unsigned int a : 1 ? 3 : 4; };
    struct s { unsigned int a : _Generic (1, int: 3, default: 1.0); };

The rules now call constExprValue once and use its value for the width
and for the check for a negative width.

Adds tests/bitfield-width-expr.c and valdiag/tests/bitfield-width-expr.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCC.y                                    | 10 +-
 .../regression/tests/bitfield-width-expr.c    | 99 +++++++++++++++++++
 support/valdiag/tests/bitfield-width-expr.c   | 39 ++++++++
 3 files changed, 144 insertions(+), 4 deletions(-)
 create mode 100644 support/regression/tests/bitfield-width-expr.c
 create mode 100644 support/valdiag/tests/bitfield-width-expr.c

diff --git a/src/SDCC.y b/src/SDCC.y
index d0edec21f..bc7840d3e 100644
--- a/src/SDCC.y
+++ b/src/SDCC.y
@@ -1094,9 +1094,10 @@ member_declarator
    | ':' constant_expr
         {
           unsigned int bitsize;
+          value *val = constExprValue($2, true);
           $$ = newSymbol (genSymName(NestLevel), NestLevel);
-          bitsize = (unsigned int) ulFromVal(constExprValue($2, true));
-          if (floatFromVal (constExprValue($2, true)) < 0)
+          bitsize = (unsigned int) ulFromVal(val);
+          if (floatFromVal (val) < 0)
               werror (E_NEGATIVE_BITFLD_SIZE);
           else if (!bitsize)
               bitsize = BITVAR_PAD;
@@ -1106,8 +1107,9 @@ member_declarator
    | declarator ':' constant_expr
         {
           unsigned int bitsize;
-          bitsize = (unsigned int) ulFromVal(constExprValue($3, true));
-          if (floatFromVal (constExprValue($3, true)) < 0)
+          value *val = constExprValue($3, true);
+          bitsize = (unsigned int) ulFromVal(val);
+          if (floatFromVal (val) < 0)
               werror (E_NEGATIVE_BITFLD_SIZE);
           else if (!bitsize)
             {
diff --git a/support/regression/tests/bitfield-width-expr.c b/support/regression/tests/bitfield-width-expr.c
new file mode 100644
index 000000000..b680aac21
--- /dev/null
+++ b/support/regression/tests/bitfield-width-expr.c
@@ -0,0 +1,99 @@
+/** bitfield-width-expr.c
+    The width of a bit-field is a constant expression. For a conditional
+    operator with a constant condition and for a generic selection, the
+    width is the value of the operand that is selected.
+ */
+
+#include <testfwk.h>
+
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+#define HAVE_GENERIC
+#endif
+
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+
+enum { LOW_BITS = 3 };
+
+struct bits
+{
+  unsigned int a : 1 ? 3 : 4;
+  unsigned int : 0 ? 3 : 2;
+  unsigned int b : 0 ? 3 : 5;
+#ifdef HAVE_GENERIC
+  unsigned int c : _Generic (1, int : 6, default : 1.0);
+#endif
+};
+
+/* struct bits with each width written as a number */
+struct plain
+{
+  unsigned int a : 3;
+  unsigned int : 2;
+  unsigned int b : 5;
+#ifdef HAVE_GENERIC
+  unsigned int c : 6;
+#endif
+};
+
+struct sized
+{
+  unsigned int low : MAX (LOW_BITS, 2);
+  unsigned int high : LOW_BITS > 4 ? 1 : 8 - LOW_BITS;
+};
+
+union
+{
+  struct bits expr;
+  struct plain number;
+} overlay;
+
+void
+testWidth (void)
+{
+  struct bits s;
+  struct sized t;
+
+  s.a = 0xff;
+  s.b = 0xff;
+  ASSERT (s.a == 7);
+  ASSERT (s.b == 31);
+
+#ifdef HAVE_GENERIC
+  s.c = 0xff;
+  ASSERT (s.c == 63);
+#endif
+
+  t.low = 0xff;
+  t.high = 0xff;
+  ASSERT (t.low == 7);
+  ASSERT (t.high == 31);
+}
+
+/* The unnamed bit-field has 2 bits, so that b and c are at the positions
+   that they have in struct plain. */
+void
+testLayout (void)
+{
+  ASSERT (sizeof (struct bits) == sizeof (struct plain));
+
+  overlay.number.a = 0;
+  overlay.number.b = 0;
+#ifdef HAVE_GENERIC
+  overlay.number.c = 0;
+#endif
+
+  overlay.expr.b = 21;
+  ASSERT (overlay.number.a == 0);
+  ASSERT (overlay.number.b == 21);
+
+#ifdef HAVE_GENERIC
+  ASSERT (overlay.number.c == 0);
+  overlay.expr.c = 42;
+  ASSERT (overlay.number.b == 21);
+  ASSERT (overlay.number.c == 42);
+#endif
+
+  overlay.expr.a = 5;
+  ASSERT (overlay.number.a == 5);
+  ASSERT (overlay.number.b == 21);
+}
diff --git a/support/valdiag/tests/bitfield-width-expr.c b/support/valdiag/tests/bitfield-width-expr.c
new file mode 100644
index 000000000..c029e64d4
--- /dev/null
+++ b/support/valdiag/tests/bitfield-width-expr.c
@@ -0,0 +1,39 @@
+/* bitfield-width-expr.c
+
+   The width of a bit-field can be a conditional operator with a constant
+   condition or a generic selection. The value of the operand that is
+   selected is the width, and it is checked as a width that is written as
+   a number.
+ */
+
+#ifdef TEST1
+struct s
+{
+  int a : 1 ? 3 : 4;
+  int : 0 ? 3 : 2;
+  int b : 0 ? 3 : 5;
+};
+#endif
+
+#ifdef TEST2
+struct s
+{
+  int a : _Generic (1, int: 3, default: 1.0);
+  int : _Generic (1, float: 1.0f, default: 2);
+};
+#endif
+
+#ifdef TEST3
+struct s
+{
+  int a : 0 ? 3 : -1; /* ERROR */
+};
+#endif
+
+#ifdef TEST4
+struct s
+{
+  int a;
+  int : 1 ? -2 : 2; /* ERROR */
+};
+#endif
