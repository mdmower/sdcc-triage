From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Tue, 10 Nov 2026 01:55:19 -0800
Subject: [PATCH] [bugs #4249] The address of an array points to the array, not
 to its first element

By the time unary & is turned into intermediate code an array operand has
already become a pointer to its first element, and that pointer was returned
as the result. '&array + 1' and 'p++' compared against it then stepped by
one element. The tree is decorated with the right type, pointer to array:
give the result that type.

Adds tests/bug-4249.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/SDCCicode.c                     | 11 +++++++++-
 support/regression/tests/bug-4249.c | 32 +++++++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 support/regression/tests/bug-4249.c

diff --git a/src/SDCCicode.c b/src/SDCCicode.c
index c9a86a426..defb08b60 100644
--- a/src/SDCCicode.c
+++ b/src/SDCCicode.c
@@ -4750,7 +4750,16 @@ ast2iCode (ast * tree, int lvl)
           return geniCodeBitwise (left, right, BITWISEAND, tree->ftype);
         }
       else
-        return geniCodeAddressOf (left);
+        {
+          operand *result = geniCodeAddressOf (left);
+
+          /* An array operand has already become a pointer to its first element, and comes back
+             as that. The address of an array points to the whole array, though: give the result
+             the type the tree was decorated with, so that arithmetic on it steps by arrays. */
+          if (tree->left && IS_ARRAY (tree->left->ftype) && IS_ITEMP (result) && tree->ftype && IS_PTR (tree->ftype))
+            setOperandType (result, tree->ftype);
+          return result;
+        }
 
     case '|':                  /* bitwise or & xor */
     case '^':
diff --git a/support/regression/tests/bug-4249.c b/support/regression/tests/bug-4249.c
new file mode 100644
index 000000000..568b72966
--- /dev/null
+++ b/support/regression/tests/bug-4249.c
@@ -0,0 +1,32 @@
+/* bug-4249.c
+   The address of an array, &array, has type pointer to array; adding 1 to it
+   must step over the whole array. It was scaled by the element size instead.
+ */
+
+#include <testfwk.h>
+
+static char array[16];
+static char *seen;
+
+static void
+sink (char *p)
+{
+  seen = p;
+}
+
+static int
+test (void)
+{
+  char (*p)[16] = &array;
+
+  sink (*p++);
+  return p == &array + 1;
+}
+
+void
+testBug (void)
+{
+  ASSERT (test ());
+  ASSERT (seen == array);
+  ASSERT ((char *)(&array + 1) == array + 16);
+}
