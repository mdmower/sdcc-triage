       idx = skipaliases ? nextInitSlot (type, idx) : idx + 1;
     }
 
@@ -755,6 +771,7 @@ static initList *reorderIlistFull (sym_link * type, initList * ilist, bool skipa
   initList *iloop, *nlist, **nlistArray, **partArray = NULL;
