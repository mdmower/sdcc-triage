From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Mower <mdmower@cmphys.com>
Date: Mon, 9 Nov 2026 21:55:52 -0800
Subject: [PATCH] [bugs #4158] mcs51: free the operand of a struct return

genRet's struct-return path jumped to jumpret without freeing IC_LEFT's
asmop. A later return of the same variable then reused the cached asmop,
including its current DPTR offset, instead of loading the address again,
and read from wherever DPTR happened to point. Seen with --model-large,
--model-huge and --model-large --stack-auto.

Adds regression test bug-4158.c.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mcs51/gen.c                     |  1 +
 support/regression/tests/bug-4158.c | 69 +++++++++++++++++++++++++++++
 2 files changed, 70 insertions(+)
 create mode 100644 support/regression/tests/bug-4158.c

diff --git a/src/mcs51/gen.c b/src/mcs51/gen.c
index d5d29586d..9189ad43f 100644
--- a/src/mcs51/gen.c
+++ b/src/mcs51/gen.c
@@ -5608,6 +5608,7 @@ genRet (iCode *ic)
             }
         }
       freeAsmop (0, aop, ic, true);
+      freeAsmop (IC_LEFT (ic), NULL, ic, true);
       goto jumpret;
     }
 
diff --git a/support/regression/tests/bug-4158.c b/support/regression/tests/bug-4158.c
new file mode 100644
index 000000000..b8b435d4c
--- /dev/null
+++ b/support/regression/tests/bug-4158.c
@@ -0,0 +1,69 @@
+/* bug-4158.c
+   Returning the same struct variable from two return statements gave wrong
+   values from the second one for mcs51 with --model-large: the operand of the
+   first return was never freed, so the second return reused its stale pointer
+   state instead of loading the address again.
+ */
+
+#include <testfwk.h>
+
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+struct s
+{
+  unsigned char a, b;
+};
+
+struct s
+mk (unsigned char x)
+{
+  struct s v;
+  v.a = x;
+  v.b = x + 1;
+  return v;
+}
+
+struct s
+twice (unsigned char c, unsigned char x)
+{
+  struct s r = mk (x);
+  if (c)
+    return r;
+  return r;
+}
+
+struct s
+thrice (unsigned char c, unsigned char x)
+{
+  struct s r = mk (x);
+  if (c == 0)
+    return r;
+  if (c == 1)
+    return r;
+  return r;
+}
+#endif
+
+void
+testBug (void)
+{
+#if !defined(__SDCC_hc08) && !defined(__SDCC_s08) && !defined(SDCC_MOS) // struct return not yet supported
+  struct s r;
+
+  r = twice (1, 0x10);
+  ASSERT (r.a == 0x10);
+  ASSERT (r.b == 0x11);
+  r = twice (0, 0x20);
+  ASSERT (r.a == 0x20);
+  ASSERT (r.b == 0x21);
+
+  r = thrice (0, 0x30);
+  ASSERT (r.a == 0x30);
+  ASSERT (r.b == 0x31);
+  r = thrice (1, 0x40);
+  ASSERT (r.a == 0x40);
+  ASSERT (r.b == 0x41);
+  r = thrice (2, 0x50);
+  ASSERT (r.a == 0x50);
+  ASSERT (r.b == 0x51);
+#endif
+}
